/* READ TEXT */

void read_text(char message[], char text[], int size)
{
    int length;
    int c;

    while (1)
    {
        printf("%s", message);

        if (fgets(text, size, stdin) == NULL)
            exit(0);

        length = strlen(text);

        if (length > 0 && text[length - 1] == '\n')
        {
            text[length - 1] = '\0';
        }
        else if (!feof(stdin))
        {
            while ((c = getchar()) != '\n' && c != EOF);

            printf("Input is too long. Try again.\n");
            continue;
        }

        if (strlen(text) == 0)
        {
            printf("Input cannot be empty.\n");
            continue;
        }

        return;
    }
}

/* VALIDATE NAME */

int valid_name(char name[])
{
    int i;
    int letters = 0;

    for (i = 0; name[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)name[i]))
            letters++;

        else if (name[i] != ' ' &&
                 name[i] != '-' &&
                 name[i] != '\'')
            return 0;
    }

    return letters >= 3;
}

/* VALIDATE ACCOUNT NUMBER */

int valid_account(char account[])
{
    int i;
    int length = strlen(account);

    if (length < 3 || length > 15)
        return 0;

    for (i = 0; account[i] != '\0'; i++)
    {
        if (!isdigit((unsigned char)account[i]))
            return 0;
    }

    return 1;
}

/* VALIDATE BILLING PERIOD */

int valid_period(char period[])
{
    int i;
    int month;

    if (strlen(period) != 7)
        return 0;

    if (period[2] != '/')
        return 0;

    for (i = 0; i < 7; i++)
    {
        if (i != 2 && !isdigit((unsigned char)period[i]))
            return 0;
    }

    month = (period[0] - '0') * 10 +
            (period[1] - '0');

    if (month < 1 || month > 12)
        return 0;

    return 1;
}

/* READ A NUMBER */

double read_number(char message[], double minimum, double maximum)
{
    char line[100];
    char *end;
    double number;

    while (1)
    {
        read_text(message, line, sizeof(line));

        errno = 0;
        number = strtod(line, &end);

        while (isspace((unsigned char)*end))
            end++;

        if (end == line || *end != '\0' ||
            errno == ERANGE || !isfinite(number))
        {
            printf("Invalid input. Enter a valid number.\n");
            continue;
        }

        if (number < minimum || number > maximum)
        {
            printf("Number must be between %.2f and %.2f.\n",
                   minimum, maximum);
            continue;
        }

        return number;
    }
}

/* READ INTEGER CHOICE */

int read_choice(char message[], int minimum, int maximum)
{
    double number;

    while (1)
    {
        number = read_number(message, minimum, maximum);

        if (number == (int)number)
            return (int)number;

        printf("Please enter a whole number.\n");
    }
}

/* READ PREVIOUS AND CURRENT INDEXES */

void read_indexes(double *previous, double *current)
{
    while (1)
    {
        *previous = read_number(
            "Enter previous index: ", 0, 1000000000);

        *current = read_number(
            "Enter current index: ", 0, 1000000000);

        if (*current >= *previous)
            break;

        printf("Error: current index must be greater than or equal to previous index.\n");
    }
}

/* MAIN FUNCTION */

int main()
{
    char name[60];
    char account[20];
    char period[10];
    char filename[30];

    BillLine lines[5];

    int invoice_number = 1;
    int another_bill;
    int save_choice;

    int choice;
    int package;
    int minutes;
    int speed;

    int count;
    int selected[6];

    int i;

    double previous;
    double current;

    FILE *file;

    do
    {
        count = 0;

        /* RESET SELECTED SERVICES */

        for (i = 0; i < 6; i++)
        {
            selected[i] = 0;
        }

        /* CUSTOMER INFORMATION */

        printf("\n================================================\n");
        printf("              CUSTOMER INFORMATION\n");
        printf("================================================\n");

        do
        {
            read_text("Enter customer name: ", name, sizeof(name));

            if (!valid_name(name))
                printf("Name must contain at least 3 letters.\n");

        } while (!valid_name(name));

        do
        {
            read_text("Enter account number: ",
                      account, sizeof(account));

            if (!valid_account(account))
                printf("Account number must contain 3 to 15 digits.\n");

        } while (!valid_account(account));

        do
        {
            read_text("Enter billing period (MM/YYYY): ",
                      period, sizeof(period));

            if (!valid_period(period))
                printf("Invalid period. Example: 11/2026.\n");

        } while (!valid_period(period));


        /* SERVICE MENU */

        do
        {
            printf("\n================================================\n");
            printf("                  SERVICE MENU\n");
            printf("================================================\n");

            printf("1. Electricity\n");
            printf("2. Gas\n");
            printf("3. Water\n");
            printf("4. Telephone\n");
            printf("5. Internet\n");
            printf("0. Finish bill\n");

            choice = read_choice("Enter your choice: ", 0, 5);

            if (choice == 0)
            {
                if (count == 0)
                    printf("Please select at least one service.\n");

                continue;
            }

            /* CHECK DUPLICATE SERVICES */

            if (selected[choice] == 1)
            {
                printf("This service has already been selected.\n");
                continue;
            }

            selected[choice] = 1;

            /* CLEAR CURRENT BILL LINE */

            memset(&lines[count], 0, sizeof(BillLine));


            /* ELECTRICITY */

            if (choice == 1)
            {
                strcpy(lines[count].service, "Electricity");
                strcpy(lines[count].details, "kWh");

                read_indexes(&previous, &current);

                lines[count].previous_index = previous;
                lines[count].current_index = current;

                lines[count].consumption = current - previous;

                lines[count].amount =
                    electricity_amount(lines[count].consumption);

                lines[count].vat_rate = 0.09;
            }


            /* GAS */

            else if (choice == 2)
            {
                strcpy(lines[count].service, "Gas");
                strcpy(lines[count].details, "m3");

                read_indexes(&previous, &current);

                lines[count].previous_index = previous;
                lines[count].current_index = current;

                lines[count].consumption = current - previous;

                lines[count].amount =
                    gas_amount(lines[count].consumption);

                lines[count].vat_rate = 0.09;
            }


            /* WATER */

            else if (choice == 3)
            {
                strcpy(lines[count].service, "Water");
                strcpy(lines[count].details, "m3");

                read_indexes(&previous, &current);

                lines[count].previous_index = previous;
                lines[count].current_index = current;

                lines[count].consumption = current - previous;

                lines[count].amount =
                    water_amount(lines[count].consumption);

                lines[count].vat_rate = 0.09;
            }


            /* TELEPHONE */

            else if (choice == 4)
            {
                strcpy(lines[count].service, "Telephone");

                minutes = read_choice(
                    "Enter number of minutes: ", 0, 100000);

                sprintf(lines[count].details,
                        "%d minutes", minutes);

                lines[count].consumption = minutes;

                lines[count].amount = phone_amount(minutes);

                lines[count].vat_rate = 0.19;
            }


            /* INTERNET */

            else if (choice == 5)
            {
                strcpy(lines[count].service, "Internet");

                printf("\nInternet packages:\n");
                printf("1. 4 Mbps  - 1000 DA\n");
                printf("2. 8 Mbps  - 1500 DA\n");
                printf("3. 20 Mbps - 2500 DA\n");

                package = read_choice(
                    "Choose a package: ", 1, 3);

                if (package == 1)
                    speed = 4;

                else if (package == 2)
                    speed = 8;

                else
                    speed = 20;

                sprintf(lines[count].details,
                        "%d Mbps", speed);

                lines[count].consumption = speed;

                lines[count].amount = internet_amount(speed);

                lines[count].vat_rate = 0.19;
            }

            count++;

            printf("\nService added successfully!\n");

        } while (choice != 0 || count == 0);


        /* DISPLAY THE BILL */

        printf("\nYour bill is ready!\n");

        print_bill(stdout, name, account, period, lines, count);


        /* ASK TO SAVE THE BILL */

        save_choice = read_choice(
            "\nDo you want to save the bill? (1 = Yes, 0 = No): ",
            0, 1);

        if (save_choice == 1)
        {
            sprintf(filename, "invoice_%d.txt", invoice_number);

            file = fopen(filename, "w");

            if (file != NULL)
            {
                print_bill(file, name, account, period, lines, count);

                fclose(file);

                printf("\nBill saved successfully in %s\n", filename);
            }
            else
            {
                printf("\nError: Could not save the bill.\n");
            }
        }
        else
        {
            printf("\nBill was not saved.\n");
        }

        invoice_number++;


        /* ASK FOR ANOTHER BILL */

        another_bill = read_choice(
            "\nDo you want to create another bill? (1 = Yes, 0 = No): ",
            0, 1);

    } while (another_bill == 1);


    printf("\nThank you for using our billing system!\n");

    return 0;
}
