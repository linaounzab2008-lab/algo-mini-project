/* ELECTRICITY */

double electricity_amount(double consumption)
{
    double amount = 100;

    if (consumption <= 100)
        amount += consumption * 2;

    else if (consumption <= 300)
        amount += 100 * 2 + (consumption - 100) * 4;

    else
        amount += 100 * 2 + 200 * 4 + (consumption - 300) * 6;

    return amount;
}

/* GAS */

double gas_amount(double consumption)
{
    double amount = 50;

    if (consumption <= 100)
        amount += consumption * 1.5;

    else if (consumption <= 300)
        amount += 100 * 1.5 + (consumption - 100) * 3;

    else
        amount += 100 * 1.5 + 200 * 3 + (consumption - 300) * 4.5;

    return amount;
}

/* WATER */

double water_amount(double consumption)
{
    double usage;
    double sanitation;

    if (consumption <= 20)
        usage = consumption * 6;

    else if (consumption <= 40)
        usage = 20 * 6 + (consumption - 20) * 20;

    else
        usage = 20 * 6 + 20 * 20 + (consumption - 40) * 40;

    sanitation = usage * 0.10;

    return usage + sanitation + 100;
}

/* TELEPHONE */

double phone_amount(int minutes)
{
    double amount = 600;

    if (minutes > 100)
        amount += (minutes - 100) * 3;

    return amount;
}

/* INTERNET */

double internet_amount(int speed)
{
    if (speed == 4)
        return 1000;

    else if (speed == 8)
        return 1500;

    else
        return 2500;
}

/* DISPLAY BILL */

void print_bill(FILE *out, char name[], char account[],
                char period[], BillLine lines[], int count)
{
    int i;

    double total_ht = 0;
    double total_vat = 0;
    double total_ttc = 0;

    fprintf(out, "\n");
    fprintf(out, "===============================================================\n");
    fprintf(out, "                         CUSTOMER BILL\n");
    fprintf(out, "===============================================================\n");

    fprintf(out, "Customer Name  : %s\n", name);
    fprintf(out, "Account Number : %s\n", account);
    fprintf(out, "Billing Period : %s\n", period);

    fprintf(out, "___________________________________________________________________________________________\n");

    fprintf(out, "| %-12s | %8s | %8s | %-16s | %9s | %7s | %8s |\n",
            "Service", "Previous", "Current", "Consumption",
            "Amount HT", "VAT", "TTC");

    fprintf(out, "___________________________________________________________________________________________\n");

    for (i = 0; i < count; i++)
    {
        char previous[20];
        char current[20];
        char consumption[40];

        double vat;
        double ttc;

        if (strcmp(lines[i].service, "Electricity") == 0 ||
            strcmp(lines[i].service, "Gas") == 0 ||
            strcmp(lines[i].service, "Water") == 0)
        {
            sprintf(previous, "%.2f", lines[i].previous_index);
            sprintf(current, "%.2f", lines[i].current_index);

            sprintf(consumption, "%.2f %s",
                    lines[i].consumption, lines[i].details);
        }
        else
        {
            strcpy(previous, "-");
            strcpy(current, "-");

            strcpy(consumption, lines[i].details);
        }

        vat = lines[i].amount * lines[i].vat_rate;
        ttc = lines[i].amount + vat;

        total_ht += lines[i].amount;
        total_vat += vat;
        total_ttc += ttc;

        fprintf(out,
                "| %-12s | %8s | %8s | %-16s | %9.2f | %7.2f | %8.2f |\n",
                lines[i].service,
                previous,
                current,
                consumption,
                lines[i].amount,
                vat,
                ttc);
    }

    fprintf(out, "___________________________________________________________________________________________\n");

    fprintf(out, "| TOTAL BEFORE TAX                                      %10.2f DA             |\n",
            total_ht);

    fprintf(out, "| TOTAL VAT                                             %10.2f DA             |\n",
            total_vat);

    fprintf(out, "| TOTAL TO PAY                                          %10.2f DA             |\n",
            total_ttc);

    fprintf(out, "===========================================================================================\n");
}




















